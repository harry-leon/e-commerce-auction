{
  "info": {
    "_postman_id": "nexus-cart-order-spec-v1",
    "name": "Nexus E-Commerce - Cart & Order API Spec",
    "description": "Postman Collection for Shopping Cart and Order Management Modules (Sprint 2 Alignment).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Shopping Cart",
      "item": [
        {
          "name": "1. Get Active Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "2. Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuId\": \"e5b8d2a1-7c91-4c12-8e10-6a7f1e9b2c01\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items"]
            }
          }
        },
        {
          "name": "3. Update Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items/:itemId",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", ":itemId"],
              "variable": [
                {
                  "key": "itemId",
                  "value": "item-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "4. Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/:itemId",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", ":itemId"],
              "variable": [
                {
                  "key": "itemId",
                  "value": "item-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "5. Clear Entire Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items"]
            }
          }
        }
      ]
    },
    {
      "name": "Order & Checkout",
      "item": [
        {
          "name": "1. Checkout Preview & Price Re-validation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemIds\": [\"item-uuid-1\"],\n  \"shippingAddress\": \"123 Le Loi, District 1, HCMC\",\n  \"voucherCode\": \"SALE2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/checkout/preview",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "checkout", "preview"]
            }
          }
        },
        {
          "name": "2. Create Order (Place Order with Idempotency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Le Loi, District 1, HCMC\",\n  \"recipientName\": \"Nguyen Van A\",\n  \"recipientPhone\": \"0901234567\",\n  \"voucherCode\": \"SALE2026\",\n  \"paymentMethod\": \"VNPAY\",\n  \"sourceType\": \"REGULAR\",\n  \"auctionId\": null,\n  \"selectedItemIds\": [\"item-uuid-1\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3. Get Buyer Order History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "4. Get Order Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":orderId"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "order-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "5. Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Buyer requested cancellation within eligible window.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":orderId", "cancel"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "order-uuid-here"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
