{
  "info": {
    "_postman_id": "nexus-sprint1-e2e-collection-ld-s1-4-v3",
    "name": "Nexus Sprint 1 - E2E Testing Suite (E-Commerce Flow)",
    "description": "Bộ kịch bản kiểm thử tích hợp toàn trình (E2E Test Suite) cho Sprint 1 theo Issue [LD-S1-4].\nĐã tối ưu hóa 100% bám sát payload thực tế của Web Frontend (không truyền selectedItemIds để mua toàn bộ giỏ hàng, script query params tự động cho VNPAY IPN tránh lỗi URL encoding).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "buyerToken", "value": "", "type": "string" },
    { "key": "skuId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "vnp_TmnCode", "value": "TESTONLY", "type": "string" },
    { "key": "vnp_HashSecret", "value": "TESTONLYSECRET123456789012345678", "type": "string" },
    { "key": "orderAmount", "value": "50000", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Kịch bản 1: Thanh toán thành công (Happy Path)",
      "item": [
        {
          "name": "1.1 Thêm SKU vào Giỏ hàng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Thêm giỏ hàng thành công, có items\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.items).to.be.an('array').that.is.not.empty;",
                  "    const targetSku = pm.variables.get(\"skuId\") || pm.collectionVariables.get(\"skuId\");",
                  "    const foundItem = res.data.items.find(i => i.skuId === targetSku) || res.data.items[0];",
                  "    pm.globals.set(\"cartItemId\", foundItem.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuId\": \"{{skuId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "1.2 Xem trước giỏ hàng (Checkout Preview)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const itemId = pm.globals.get(\"cartItemId\");",
                  "if (itemId) {",
                  "    pm.request.body.raw = JSON.stringify({",
                  "        itemIds: [itemId],",
                  "        shippingAddress: \"123 Đường Demo, Phường Bến Nghé, Quận 1, TP. HCM\"",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Preview trả về 200 và tính toán đúng số tiền\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.totalAmount).to.be.above(0);",
                  "    pm.globals.set(\"orderAmount\", res.data.totalAmount);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemIds\": [\"00000000-0000-0000-0000-000000000001\"],\n  \"shippingAddress\": \"123 Đường Demo, Phường Bến Nghé, Quận 1, TP. HCM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/checkout/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "checkout", "preview"]
            }
          }
        },
        {
          "name": "1.3 Tạo đơn hàng VNPAY (Place Order)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    const r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "});",
                  "pm.variables.set(\"currentIdempotencyKey\", uuid);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo đơn thành công (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Trả về orderId và paymentUrl có vnp_TxnRef\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.id).to.be.a('string');",
                  "    pm.expect(res.data.paymentUrl).to.include('vnp_TxnRef=');",
                  "    pm.globals.set(\"orderId\", res.data.id);",
                  "    pm.globals.set(\"orderNo\", res.data.orderNo);",
                  "    const urlObj = new URL(res.data.paymentUrl);",
                  "    const txnRef = urlObj.searchParams.get('vnp_TxnRef');",
                  "    pm.globals.set(\"paymentId\", txnRef);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Idempotency-Key", "value": "{{currentIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Đường Demo, Quận 1, TP. HCM\",\n  \"recipientName\": \"Nguyễn Văn Demo\",\n  \"recipientPhone\": \"0901234567\",\n  \"paymentMethod\": \"VNPAY\",\n  \"sourceType\": \"REGULAR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "1.4 Kiểm tra trạng thái Payment trước thanh toán (PENDING)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pId = pm.globals.get(\"paymentId\");",
                  "if (pId) { pm.variables.set(\"paymentId\", pId); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Payment trạng thái PENDING\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.eql(\"PENDING\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "1.5 Giả lập VNPAY IPN Thành công (ResponseCode 00)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const hashSecret = pm.collectionVariables.get(\"vnp_HashSecret\") || 'TESTONLYSECRET123456789012345678';",
                  "const txnRef = pm.globals.get(\"paymentId\");",
                  "const amount = pm.globals.get(\"orderAmount\") || '50000';",
                  "const amountParam = String(Math.round(Number(amount) * 100));",
                  "const tmnCode = pm.collectionVariables.get(\"vnp_TmnCode\") || 'TESTONLY';",
                  "const params = {",
                  "    vnp_Amount: amountParam,",
                  "    vnp_ResponseCode: '00',",
                  "    vnp_TmnCode: tmnCode,",
                  "    vnp_TransactionNo: '99887766',",
                  "    vnp_TransactionStatus: '00',",
                  "    vnp_TxnRef: txnRef",
                  "};",
                  "const sortedKeys = Object.keys(params).sort();",
                  "const unsigned = sortedKeys.map(k => `${k}=${encodeURIComponent(params[k])}`).join('&');",
                  "const hash = CryptoJS.HmacSHA512(unsigned, hashSecret).toString();",
                  "pm.request.url.query.clear();",
                  "sortedKeys.forEach(k => pm.request.url.query.add({ key: k, value: params[k] }));",
                  "pm.request.url.query.add({ key: 'vnp_SecureHash', value: hash });",
                  "pm.globals.set(\"successTxnRef\", txnRef);",
                  "pm.globals.set(\"successAmountParam\", amountParam);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"IPN phản hồi chuẩn VNPAY: RspCode 00\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.RspCode).to.eql(\"00\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/vnpay/ipn",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "vnpay", "ipn"]
            }
          }
        },
        {
          "name": "1.6 Kiểm tra Payment cập nhật SUCCESS",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pId = pm.globals.get(\"paymentId\");",
                  "if (pId) { pm.variables.set(\"paymentId\", pId); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Payment chuyển sang SUCCESS\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.eql(\"SUCCESS\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "1.7 Kiểm tra Order chuyển PAID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const oId = pm.globals.get(\"orderId\");",
                  "if (oId) { pm.variables.set(\"orderId\", oId); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order chuyển sang PAID\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.eql(\"PAID\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Kịch bản 2: Thanh toán Thất bại / Hủy đơn (Failure)",
      "item": [
        {
          "name": "2.1 Chuẩn bị hàng cho đơn hủy (Thêm SKU vào giỏ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Thêm giỏ hàng thành công cho ca hủy\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuId\": \"{{skuId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "2.2 Tạo đơn hàng thứ 2 (Chuẩn bị hủy)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    const r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "});",
                  "pm.variables.set(\"failIdempotencyKey\", uuid);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo đơn thành công 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.globals.set(\"failOrderId\", res.data.id);",
                  "const urlObj = new URL(res.data.paymentUrl);",
                  "const txnRef = urlObj.searchParams.get('vnp_TxnRef');",
                  "pm.globals.set(\"failPaymentId\", txnRef);",
                  "pm.globals.set(\"failAmount\", res.data.total);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Idempotency-Key", "value": "{{failIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"456 Đường Hủy, Quận 3, TP. HCM\",\n  \"recipientName\": \"Khách Thử Hủy\",\n  \"recipientPhone\": \"0909999888\",\n  \"paymentMethod\": \"VNPAY\",\n  \"sourceType\": \"REGULAR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "2.3 Giả lập VNPAY IPN Thất bại (ResponseCode 24)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const hashSecret = pm.collectionVariables.get(\"vnp_HashSecret\") || 'TESTONLYSECRET123456789012345678';",
                  "const txnRef = pm.globals.get(\"failPaymentId\");",
                  "const amount = pm.globals.get(\"failAmount\") || '25000';",
                  "const amountParam = String(Math.round(Number(amount) * 100));",
                  "const tmnCode = pm.collectionVariables.get(\"vnp_TmnCode\") || 'TESTONLY';",
                  "const params = {",
                  "    vnp_Amount: amountParam,",
                  "    vnp_ResponseCode: '24',",
                  "    vnp_TmnCode: tmnCode,",
                  "    vnp_TransactionNo: '0',",
                  "    vnp_TransactionStatus: '02',",
                  "    vnp_TxnRef: txnRef",
                  "};",
                  "const sortedKeys = Object.keys(params).sort();",
                  "const unsigned = sortedKeys.map(k => `${k}=${encodeURIComponent(params[k])}`).join('&');",
                  "const hash = CryptoJS.HmacSHA512(unsigned, hashSecret).toString();",
                  "pm.request.url.query.clear();",
                  "sortedKeys.forEach(k => pm.request.url.query.add({ key: k, value: params[k] }));",
                  "pm.request.url.query.add({ key: 'vnp_SecureHash', value: hash });"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"IPN nhận kết quả thất bại hợp lệ: RspCode 00\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.RspCode).to.eql(\"00\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/vnpay/ipn",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "vnpay", "ipn"]
            }
          }
        },
        {
          "name": "2.4 Kiểm tra Order chuyển CANCELLED và Payment FAILED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fOrderId = pm.globals.get(\"failOrderId\");",
                  "if (fOrderId) { pm.variables.set(\"failOrderId\", fOrderId); }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order bị CANCELLED\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.eql(\"CANCELLED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{failOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{failOrderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Kịch bản 3: Thiếu tồn kho (Out of Stock)",
      "item": [
        {
          "name": "3.1 Thử đặt hàng với item không hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Từ chối tạo đơn do item không hợp lệ hoặc thiếu kho (HTTP 400 hoặc 404 hoặc 422)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404, 422]);",
