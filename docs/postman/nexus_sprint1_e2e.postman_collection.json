              { "key": "Idempotency-Key", "value": "00000000-0000-4000-8000-000000000999" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"Kho ảo\",\n  \"recipientName\": \"Vượt kho\",\n  \"recipientPhone\": \"0900000000\",\n  \"paymentMethod\": \"VNPAY\",\n  \"selectedItemIds\": [\"00000000-0000-0000-0000-000000000999\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Kịch bản 4: Gửi Checkout trùng lặp (Idempotency Key)",
      "item": [
        {
          "name": "4.1 Chuẩn bị hàng cho đơn Idempotency",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Thêm giỏ hàng thành công cho ca Idempotency\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuId\": \"{{skuId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "4.2 Gửi Checkout lần 1 với Key cố định",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fixedKey = '11223344-5566-4778-8899-aabbccddeeff';",
                  "pm.globals.set(\"duplicateIdempotencyKey\", fixedKey);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo đơn lần đầu thành công 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.globals.set(\"firstOrderId\", res.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
