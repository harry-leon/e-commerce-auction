# Copy thành .env (đã được .gitignore). KHÔNG commit .env thật.
SYSTEM_ENV=dev
# Sinh giá trị ngẫu nhiên riêng; realm import và hai service IAM phải dùng cùng secret này.
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8180/realms/nexus-realm
# Để trống KEYCLOAK_DB_* thì dùng DB local. Với Supabase, dùng JDBC URL session pooler cổng 5432,
# sslmode=require và currentSchema khớp KEYCLOAK_DB_SCHEMA; không dùng chung schema bảng nghiệp vụ.
KEYCLOAK_DB_URL=
KEYCLOAK_DB_SCHEMA=public
KEYCLOAK_DB_USERNAME=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_POOL_MAX_SIZE=5
DB_USERNAME=nexus
DB_PASSWORD=nexus
# JWT RS256 được Keycloak ký; không chia sẻ JWT_SECRET HS256 giữa các service.

# SMTP: local Mailpit; set real provider credentials for staging/production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexus.local
FRONTEND_URL=http://localhost:3000

# Docker Compose local PostgreSQL (independent of remote DB credentials above).
LOCAL_DB_USERNAME=nexus
LOCAL_DB_PASSWORD=nexus

# Mỗi service có schema và lịch sử Flyway riêng trong Supabase.
# Để trống để dùng DB local; không ghi mật khẩu thật vào file mẫu.
SERVICE_DB_POOL_MAX_SIZE=3
CATALOG_DB_URL=
CATALOG_DB_USERNAME=
CATALOG_DB_PASSWORD=
COMMERCE_DB_URL=
COMMERCE_DB_USERNAME=
COMMERCE_DB_PASSWORD=
AUCTION_DB_URL=
AUCTION_DB_USERNAME=
AUCTION_DB_PASSWORD=
FULFILLMENT_DB_URL=
FULFILLMENT_DB_USERNAME=
FULFILLMENT_DB_PASSWORD=
NOTIFICATION_DB_URL=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
REPUTATION_DB_URL=
REPUTATION_DB_USERNAME=
REPUTATION_DB_PASSWORD=

# Flyway chỉ quản lý schema nghiệp vụ; JDBC currentSchema thêm public để tìm extension.
CATALOG_DB_SCHEMAS=
COMMERCE_DB_SCHEMAS=
AUCTION_DB_SCHEMAS=
FULFILLMENT_DB_SCHEMAS=
NOTIFICATION_DB_SCHEMAS=
REPUTATION_DB_SCHEMAS=

# TT-S2-2: tạo hai secret khác nhau, khớp realm import và service tương ứng; không commit giá trị thật.
# Realm đã tồn tại không được Keycloak tự import lại; xem docs/TT-S2-2_GATEWAY_STOMP_SECURITY.md.
AUCTION_CLIENT_SECRET=
COMMERCE_CLIENT_SECRET=
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
