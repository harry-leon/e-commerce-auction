# Copy thành .env (đã được .gitignore). KHÔNG commit .env thật.
SYSTEM_ENV=dev
# Sinh giá trị ngẫu nhiên riêng; realm import và hai service IAM phải dùng cùng secret này.
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8180/realms/nexus-realm
DB_USERNAME=nexus
DB_PASSWORD=nexus
# JWT RS256 được Keycloak ký; không chia sẻ JWT_SECRET HS256 giữa các service.

# SMTP: local Mailpit; set real provider credentials for staging/production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexus.local
FRONTEND_URL=http://localhost:3000

# Docker Compose local PostgreSQL (independent of remote DB credentials above).
LOCAL_DB_USERNAME=nexus
LOCAL_DB_PASSWORD=nexus
