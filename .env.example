# Copy thành .env (đã được .gitignore). KHÔNG commit .env thật.
SYSTEM_ENV=dev
DB_USERNAME=nexus
DB_PASSWORD=nexus
# >= 32 ký tự, dùng chung cho mọi service ở môi trường dev
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# SMTP: local Mailpit; set real provider credentials for staging/production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexus.local
FRONTEND_URL=http://localhost:3000

# Docker Compose local PostgreSQL (independent of remote DB credentials above).
LOCAL_DB_USERNAME=nexus
LOCAL_DB_PASSWORD=nexus
